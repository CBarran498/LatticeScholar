DOMAIN=research.example.edu.cn
LATTICE_PUBLIC_BASE_URL=https://research.example.edu.cn
LATTICE_REPOSITORY_URL=https://github.com/your-account/latticescholar
# Keep `core` unless you have reviewed and accepted the optional PyMuPDF license.
LATTICE_PDF_ENGINE=core
# accounts = 邮箱验证码登录（默认）；配置了 SMTP 后验证码通过邮件发送
LATTICE_AUTH_MODE=accounts
LATTICE_SESSION_SECRET=replace-with-at-least-32-random-bytes
LATTICE_SECURE_COOKIES=true
# 生产环境已配置 SMTP，dev_auth 自动关闭，无需显式设置
# LATTICE_DEV_AUTH=false
LATTICE_ADMIN_EMAILS=owner@example.edu.cn
LATTICE_TRIAL_DAYS=7
# Optional launch-wide free Pro period, ISO 8601
LATTICE_EARLY_ACCESS_UNTIL=2026-12-31T23:59:59+08:00
# Discover policy candidates every 24 hours; candidates still require admin review.
LATTICE_POLICY_SYNC_INTERVAL_HOURS=24
LATTICE_POLICY_SYNC_SOURCE_IDS=state-council,most,nsfc,moe

# Production email OTP
LATTICE_SMTP_HOST=smtp.example.com
LATTICE_SMTP_PORT=587
LATTICE_SMTP_USERNAME=mailer@example.com
LATTICE_SMTP_PASSWORD=replace-me
LATTICE_SMTP_FROM_EMAIL=mailer@example.com
LATTICE_SMTP_USE_TLS=true

# Stripe subscriptions (leave billing disabled until Checkout + webhook are tested)
LATTICE_BILLING_ENABLED=false
LATTICE_BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Hosted Free limits
LATTICE_FREE_SEARCHES_PER_DAY=20
LATTICE_FREE_ANALYSES_PER_DAY=5
LATTICE_FREE_JOURNAL_MATCHES_PER_DAY=3
LATTICE_FREE_IDEAS_PER_DAY=1
LATTICE_FREE_LIBRARY_ITEMS=50

# Scholarly sources
CROSSREF_EMAIL=research@example.edu.cn
NCBI_EMAIL=research@example.edu.cn
NCBI_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
WOS_API_KEY=

# Optional model: none | ollama | openai_compatible | deepseek
LATTICE_LLM_PROVIDER=none
LATTICE_LLM_BASE_URL=http://host.docker.internal:11434
LATTICE_LLM_API_KEY=
LATTICE_LLM_MODEL=qwen2.5:7b
LATTICE_ALLOW_REMOTE_LLM=false

# DeepSeek server-side configuration. Prefer Docker/Kubernetes secrets in production.
DEEPSEEK_API_KEY=
LATTICE_DEEPSEEK_BASE_URL=https://api.deepseek.com
LATTICE_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
LATTICE_DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
LATTICE_DEEPSEEK_ROUTING=balanced
LATTICE_DEEPSEEK_THINKING=adaptive
LATTICE_DEEPSEEK_REASONING_EFFORT=high
LATTICE_DEEPSEEK_TIMEOUT_SECONDS=180
LATTICE_DEEPSEEK_MAX_RETRIES=1

# Required for stable decryption of browser-configured BYOK keys across deployments.
LATTICE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-long-random-secret-from-secret-manager
# Arbitrary remote custom gateways are disabled to reduce SSRF risk.
LATTICE_ALLOW_CUSTOM_MODEL_HOSTS=false
