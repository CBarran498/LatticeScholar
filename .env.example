# Scholarly sources
CROSSREF_EMAIL=you@university.edu
SEMANTIC_SCHOLAR_API_KEY=
OPENALEX_API_KEY=
NCBI_EMAIL=you@university.edu
NCBI_API_KEY=
WOS_API_KEY=

# Local runtime
LATTICE_HOST=127.0.0.1
LATTICE_PORT=8765
LATTICE_CACHE_TTL=86400
# core uses the Apache-compatible default dependency set.
# pymupdf requires `pip install -e ".[advanced-pdf]"` and separate license review.
LATTICE_PDF_ENGINE=core
# LATTICE_DATA_DIR=/absolute/path/to/private/data
# accounts = 邮箱验证码登录（默认，推荐）
# open = 无需登录，自托管社区版
# shared = 旧版单密码工作区
LATTICE_AUTH_MODE=accounts
LATTICE_ACCESS_PASSWORD=
LATTICE_SESSION_SECRET=
LATTICE_SECURE_COOKIES=false
LATTICE_REPOSITORY_URL=https://github.com/CBarran498/LatticeScholar
# 0 disables in-process policy discovery. Use 24 for daily discovery on an always-on server.
LATTICE_POLICY_SYNC_INTERVAL_HOURS=0
LATTICE_POLICY_SYNC_SOURCE_IDS=state-council,most,nsfc,moe

# 邮箱登录与权益
# 验证码默认通过公共邮件代理发送（无需配置）
# 如需使用自己的 SMTP 服务，配置以下 SMTP 项即可覆盖
# LATTICE_MAIL_API_URL=https://lattice-mail.latticescholar.workers.dev
# LATTICE_DEV_AUTH=true 仅供开发测试用（验证码写入本地日志而不发邮件）
LATTICE_ADMIN_EMAILS=owner@example.edu
LATTICE_TRIAL_DAYS=7
LATTICE_EARLY_ACCESS_UNTIL=
LATTICE_SMTP_HOST=
LATTICE_SMTP_PORT=587
LATTICE_SMTP_USERNAME=
LATTICE_SMTP_PASSWORD=
LATTICE_SMTP_FROM_EMAIL=
LATTICE_SMTP_USE_TLS=true

# Hosted Free limits
LATTICE_FREE_SEARCHES_PER_DAY=20
LATTICE_FREE_ANALYSES_PER_DAY=5
LATTICE_FREE_JOURNAL_MATCHES_PER_DAY=3
LATTICE_FREE_IDEAS_PER_DAY=1
LATTICE_FREE_LIBRARY_ITEMS=50

# Optional hosted subscription billing
LATTICE_BILLING_ENABLED=false
LATTICE_BILLING_PROVIDER=stripe
LATTICE_PUBLIC_BASE_URL=http://127.0.0.1:8765
STRIPE_SECRET_KEY=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Optional LLM: none | ollama | openai_compatible | deepseek
LATTICE_LLM_PROVIDER=none
LATTICE_LLM_BASE_URL=http://127.0.0.1:11434
LATTICE_LLM_MODEL=qwen2.5:7b
LATTICE_LLM_API_KEY=
LATTICE_LLM_MAX_INPUT_CHARS=14000
LATTICE_LLM_MAX_OUTPUT_TOKENS=1400
# Explicit consent required for non-local endpoints
LATTICE_ALLOW_REMOTE_LLM=false

# DeepSeek (used when LATTICE_LLM_PROVIDER=deepseek)
# Never commit a real key. Configure it only on the server or in a secret manager.
DEEPSEEK_API_KEY=
LATTICE_DEEPSEEK_BASE_URL=https://api.deepseek.com
LATTICE_DEEPSEEK_FAST_MODEL=deepseek-v4-flash
LATTICE_DEEPSEEK_REASONING_MODEL=deepseek-v4-pro
# balanced: Flash for query strategy, Pro for analysis/Idea/discussion
# economy: always Flash; quality: always Pro
LATTICE_DEEPSEEK_ROUTING=balanced
# adaptive | enabled | disabled
LATTICE_DEEPSEEK_THINKING=adaptive
# low | high | max (Pro currently uses high or max)
LATTICE_DEEPSEEK_REASONING_EFFORT=high
LATTICE_DEEPSEEK_TIMEOUT_SECONDS=180
LATTICE_DEEPSEEK_MAX_RETRIES=1

# Browser-configured BYOK credentials are encrypted at rest.
# Production must provide a long random secret through a secret manager.
LATTICE_CREDENTIAL_ENCRYPTION_KEY=
# Keep false unless you intentionally allow arbitrary remote OpenAI-compatible hosts.
LATTICE_ALLOW_CUSTOM_MODEL_HOSTS=false
